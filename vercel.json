      "destination": "/api/seo-author?slug=$1"
    },
    {
      "source": "/authors/(.*)",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*([Bb]ot|[Cc]rawler|[Ss]pider|facebookexternalhit|Twitterbot|Slackbot|Discordbot|LinkedInBot|WhatsApp|Applebot).*" }],
