{
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(bot|crawl|spider|slurp|facebookexternalhit|twitterbot|linkedinbot|whatsapp|telegrambot|discordbot|embedly|quora link preview|pinterest|redditbot|applebot|bingbot|googlebot|yandex|baiduspider|duckduckbot|ahrefsbot|semrushbot).*" }],
      "destination": "/api/seo-home"
    },
    {
      "source": "/articles/:slug",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(bot|crawl|spider|slurp|facebookexternalhit|twitterbot|linkedinbot|whatsapp|telegrambot|discordbot|embedly|quora link preview|pinterest|redditbot|applebot|bingbot|googlebot|yandex|baiduspider|duckduckbot|ahrefsbot|semrushbot).*" }],
      "destination": "/api/seo-article?identifier=:slug"
    },
    {
      "source": "/author/:slug",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(bot|crawl|spider|slurp|facebookexternalhit|twitterbot|linkedinbot|whatsapp|telegrambot|discordbot|embedly|quora link preview|pinterest|redditbot|applebot|bingbot|googlebot|yandex|baiduspider|duckduckbot|ahrefsbot|semrushbot).*" }],
      "destination": "/api/seo-author?slug=:slug"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "themagorium.com" }],
      "destination": "https://www.themagorium.com/$1",
      "permanent": true
    },
    {
      "source": "/magorium",
      "destination": "https://themagorium.com",
      "permanent": true
    },
    {
      "source": "/magorium/:path*",
      "destination": "https://themagorium.com/:path*",
      "permanent": true
    },
    {
      "source": "/Magorium",
      "destination": "https://themagorium.com",
      "permanent": true
    },
    {
      "source": "/themagorium",
      "destination": "https://themagorium.com",
      "permanent": true
    },
    {
      "source": "/TheMagorium",
      "destination": "https://themagorium.com",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain" }
      ]
    }
  ],
  "functions": {
    "api/seo-home.ts": { "includeFiles": "dist/index.html" },
    "api/seo-article.ts": { "includeFiles": "dist/index.html" },
    "api/seo-author.ts": { "includeFiles": "dist/index.html" }
  }
}
