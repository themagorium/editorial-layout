{
  "routes": [
    {
      "src": "/favicon\\.ico",
      "dest": "/favicon.png"
    },
    {
      "src": "/favicon\\.png",
      "dest": "/favicon.png"
    },
    {
      "src": "/og-image\\.jpg",
      "dest": "/og-image.jpg"
    },
    {
      "src": "/magorium-mark\\.svg",
      "dest": "/favicon.png"
    },
    {
      "src": "/placeholder\\.svg",
      "dest": "/favicon.png"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/api/sitemap"
    },
    {
      "src": "/robots.txt",
      "dest": "/api/robots"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/articles/(.+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawler|[Ss]pider|facebookexternalhit|Twitterbot|Slackbot|Discordbot|LinkedInBot|WhatsApp|Applebot).*"
        }
      ],
      "dest": "/api/seo-article?identifier=$1"
    },
    {
      "src": "/author/(.+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawler|[Ss]pider|facebookexternalhit|Twitterbot|Slackbot|Discordbot|LinkedInBot|WhatsApp|Applebot).*"
        }
      ],
      "dest": "/api/seo-author?slug=$1"
    },
    {
      "src": "/category/(.+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawler|[Ss]pider|facebookexternalhit|Twitterbot|Slackbot|Discordbot|LinkedInBot|WhatsApp|Applebot).*"
        }
      ],
      "dest": "/api/seo-category?slug=$1"
    },
    {
      "src": "/categories/(.+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawler|[Ss]pider|facebookexternalhit|Twitterbot|Slackbot|Discordbot|LinkedInBot|WhatsApp|Applebot).*"
        }
      ],
      "dest": "/api/seo-category?slug=$1"
    },
    {
      "src": "/contributors/?",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawler|[Ss]pider|facebookexternalhit|Twitterbot|Slackbot|Discordbot|LinkedInBot|WhatsApp|Applebot).*"
        }
      ],
      "dest": "/api/seo-contributors"
    },
    {
      "src": "/seo-history/?",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawler|[Ss]pider|facebookexternalhit|Twitterbot|Slackbot|Discordbot|LinkedInBot|WhatsApp|Applebot).*"
        }
      ],
      "dest": "/api/seo-history"
    },
    {
      "src": "/(magorium|magorum|the-magorium|themagorium)/?",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawler|[Ss]pider|facebookexternalhit|Twitterbot|Slackbot|Discordbot|LinkedInBot|WhatsApp|Applebot).*"
        }
      ],
      "dest": "/api/seo-home?hint=magorium&path=/$1"
    },
    {
      "src": "/$",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawler|[Ss]pider|facebookexternalhit|Twitterbot|Slackbot|Discordbot|LinkedInBot|WhatsApp|Applebot).*"
        }
      ],
      "dest": "/api/seo-home?hint=the-magorium&path=/"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawler|[Ss]pider|facebookexternalhit|Twitterbot|Slackbot|Discordbot|LinkedInBot|WhatsApp|Applebot).*"
        }
      ],
      "dest": "/api/seo-home?path=/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
