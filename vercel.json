{
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|bingbot|Slurp|DuckDuckBot|Baiduspider|YandexBot|facebookexternalhit|Twitterbot|LinkedInBot|Applebot|ia_archiver).*"
        }
      ],
      "destination": "/api/seo-home"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "redirects": [
    {
      "source": "/magorium",
      "destination": "https://themagorium.com",
      "permanent": true
    },
    {
      "source": "/magorium/:path*",
      "destination": "https://themagorium.com/:path*",
      "permanent": true
    },
    {
      "source": "/Magorium",
      "destination": "https://themagorium.com",
      "permanent": true
    },
    {
      "source": "/themagorium",
      "destination": "https://themagorium.com",
      "permanent": true
    },
    {
      "source": "/TheMagorium",
      "destination": "https://themagorium.com",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain" }
      ]
    }
  ]
}
